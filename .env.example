# Frontend environment (no secrets in the browser bundle)

# Public Turnstile site key (safe to expose). Pair with TURNSTILE_SECRET_KEY on the Worker.
VITE_TURNSTILE_SITE_KEY=

# Optional API base when frontend is not same-origin with the Worker.
# Leave empty in production (same-origin `/api/contact`).
# For local Vite-only without proxy: VITE_API_BASE=http://127.0.0.1:8787
# VITE_API_BASE=

# -----------------------------------------------------------------------------
# Worker secrets / vars (Cloudflare — never commit real values)
# -----------------------------------------------------------------------------
#
# Required for email delivery:
#   npx wrangler secret put RESEND_API_KEY
#
# Optional Turnstile:
#   npx wrangler secret put TURNSTILE_SECRET_KEY
#
# Sender (also set as [vars].RESEND_FROM_EMAIL in wrangler.toml):
#   website@duurzaammetaalrecycling.nl  (verify domain in Resend first)
#
# Destination inbox (wrangler.toml [vars]):
#   CONTACT_EMAIL=info@duurzaammetaalrecycling.nl
#
# Local Worker testing:
#   copy worker/.dev.vars.example → worker/.dev.vars
#   Terminal A: npm run dev:api
#   Terminal B: npm run dev   (or npm run preview after build)
#   Vite proxies /api → http://127.0.0.1:8787
