# Frontend environment (no secrets in the browser bundle)

# Public Turnstile site key (safe to expose). Pair with TURNSTILE_SECRET_KEY on the Worker.
VITE_TURNSTILE_SITE_KEY=

# Optional API base when frontend is not same-origin with the Worker
# VITE_API_BASE=https://duurzaammetaalrecycling.nl

# Worker secrets (set via wrangler, never commit):
#   npx wrangler secret put RESEND_API_KEY
#   npx wrangler secret put TURNSTILE_SECRET_KEY
